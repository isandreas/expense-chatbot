# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET_TOKEN=
TELEGRAM_USER_ID=

# Groq API Key (primary AI) — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key (fallback AI) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Sheet name to store expenses
SHEET_NAME=Expenses

# (Optional, for cloud deployment) Base64-encoded credentials.json
# Generate with: base64 -i credentials.json | tr -d '\n'
# GOOGLE_CREDENTIALS_BASE64=

# Upstash Redis REST — https://console.upstash.com/
# Required for pre-commit expense staging (pending state between parse & confirm)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
